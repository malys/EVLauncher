<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Needed on API 30+ to enumerate every launchable app for the drawer. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Metrics page: read the active connection type and Wi-Fi link speed. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Metrics page, data-usage cards only: the device-wide byte counters Android's own
         Settings screen shows. Read-only, no per-app breakdown is queried, and the cards fall
         back to the permission-free since-boot counter when it is not granted. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Weather card only, and only while that card is on the metrics page: the head unit's
         weather service answers for a position, so there is nothing to ask without one. Both
         grades are declared because since API 31 the user may grant the approximate one when
         the precise one was asked for, and a city's weather does not need the precise one.
         Requested at runtime the first time a weather card is displayed — never at launch —
         and the subscription is dropped as soon as the page stops being visible. A driver who
         never adds the card is never asked and no provider is ever subscribed to. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Used only after the user opens EVSuite and taps Refresh or Download. There is no
         background check, self-update, installer permission, or privileged UID. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Vehicle cards on the metrics page: READ ONLY, and the minimum for the values shown.
         CAR_ENERGY covers the standard AAOS range and charge-port reads; CAR_VENDOR_EXTENSION
         is what the vendor property space requires to be read at all, and carries the SWI68
         fallbacks for state of charge and range. Neither permits a write, and this app calls
         no setter: every vehicle value arrives through EVHardware's telemetry reader, which
         exposes getters only. Deliberately absent, though EVChargePilot holds them: CAR_SPEED
         (no speed is shown), CAR_EXTERIOR_ENVIRONMENT (no outside temperature) and
         CONTROL_CAR_CLIMATE (no HVAC state — and its name alone is a reason not to hold it in
         the app that owns the home screen). See docs/CR-010-vehicle-page.md. -->
    <uses-permission android:name="android.car.permission.CAR_ENERGY" />
    <uses-permission android:name="android.car.permission.CAR_VENDOR_EXTENSION" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.EVLauncher">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:stateNotNeeded="true"
            android:theme="@style/Theme.EVLauncher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MetricPickerActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.EVLauncher.Drawer" />

        <activity
            android:name=".AppDrawerActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.EVLauncher.Drawer" />

        <activity
            android:name=".suite.SuiteManagerActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.EVLauncher.Drawer" />
    </application>

</manifest>
