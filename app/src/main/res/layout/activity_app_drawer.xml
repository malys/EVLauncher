<?xml version="1.0" encoding="utf-8"?>
<!-- App drawer. Header controls all sit on the MG4 tonal button surface and honour the
     suite's 64 dp touch target; the grid below is flat on the background. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/screen_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_md"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/drawer_back_button"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:layout_marginEnd="@dimen/spacing_md"
            android:background="@drawable/ev_tonal_button"
            android:clickable="true"
            android:contentDescription="@string/cd_back"
            android:focusable="true"
            android:padding="@dimen/spacing_md"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/drawer_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="@style/Text.EV.Title"
            android:textSize="@dimen/drawer_title_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/system_apps_button"
            style="@style/Widget.EV.HeaderButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:text="@string/system_apps" />

        <TextView
            android:id="@+id/suite_apps_button"
            style="@style/Widget.EV.HeaderButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:text="@string/suite_title" />

        <TextView
            android:id="@+id/about_button"
            style="@style/Widget.EV.HeaderButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:text="@string/about_action" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/app_grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:scrollbars="vertical" />
</LinearLayout>
