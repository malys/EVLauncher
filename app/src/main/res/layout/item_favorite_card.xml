<?xml version="1.0" encoding="utf-8"?>
<!-- One favorite tile, added to the home grid at runtime: the number of tiles follows the
     number of chosen apps, so it cannot be laid out statically. Every app icon gets the same
     square viewport so drawable intrinsic sizes cannot make neighboring icons look uneven.
     Padding is the small step, so the room goes to the icon rather than to the border. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bigcard_selector"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/spacing_sm">

    <!-- The frame absorbs the variable card height. The icon is the largest square the frame
         allows (SquareIconView), capped by maxWidth: wrap_content would use each drawable's
         intrinsic dimensions and produce icons of different sizes on identical tiles. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.evsuite.launcher.SquareIconView
            android:id="@+id/favorite_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:contentDescription="@string/add_favorite"
            android:maxWidth="@dimen/favorite_icon_max"
            android:scaleType="fitCenter" />
    </FrameLayout>

    <TextView
        android:id="@+id/favorite_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/add_favorite"
        android:textColor="@color/ev_text_primary"
        android:textSize="@dimen/favorite_label_size" />
</LinearLayout>
