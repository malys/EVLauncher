<?xml version="1.0" encoding="utf-8"?>
<!-- One favorite tile, added to the home grid at runtime: the number of tiles follows the
     number of chosen apps, so it cannot be laid out statically. The icon takes the leftover
     height instead of a fixed size, which is what lets the same tile work at 1x4 and 3x4. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bigcard_selector"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/spacing_md">

    <!-- The icon takes the leftover height but is capped: on a single-tile home the tile is
         the size of the screen, and an icon scaled to match reads as a graphic, not a
         button. The frame carries the weight so the ImageView can honour maxWidth/maxHeight,
         which it only does when its own size is wrap_content. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/favorite_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:adjustViewBounds="true"
            android:contentDescription="@string/add_favorite"
            android:maxWidth="@dimen/favorite_icon_size"
            android:maxHeight="@dimen/favorite_icon_size"
            android:scaleType="fitCenter" />
    </FrameLayout>

    <TextView
        android:id="@+id/favorite_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/add_favorite"
        android:textColor="@color/mg4_text_primary"
        android:textSize="@dimen/favorite_label_size" />
</LinearLayout>
