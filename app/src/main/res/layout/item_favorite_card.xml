<?xml version="1.0" encoding="utf-8"?>
<!-- One favorite tile, added to the home grid at runtime: the number of tiles follows the
     number of chosen apps, so it cannot be laid out statically. Every app icon gets the same
     square viewport so drawable intrinsic sizes cannot make neighboring icons look uneven. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bigcard_selector"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/spacing_md">

    <!-- The frame absorbs the variable card height. The ImageView itself stays a fixed square:
         wrap_content would use each app drawable's intrinsic dimensions and produce icons with
         different widths even though their launcher buttons are identical. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/favorite_icon"
            android:layout_width="@dimen/favorite_icon_size"
            android:layout_height="@dimen/favorite_icon_size"
            android:layout_gravity="center"
            android:contentDescription="@string/add_favorite"
            android:scaleType="fitCenter" />
    </FrameLayout>

    <TextView
        android:id="@+id/favorite_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/add_favorite"
        android:textColor="@color/ev_text_primary"
        android:textSize="@dimen/favorite_label_size" />
</LinearLayout>
