<?xml version="1.0" encoding="utf-8"?>
<!-- One metric tile, added to the metrics grid at runtime. Same three-part shape the fixed
     system and vehicle cards had before the merge: label on top, the value in the middle, and
     the caption that says what the value is — or which kind of silence the dash means. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/smallcard_selector"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="@dimen/info_card_padding">

    <TextView
        android:id="@+id/metric_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/ev_text_primary"
        android:textSize="@dimen/small_card_label_size"
        android:textStyle="bold" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/metric_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/veh_unknown"
        android:textColor="@color/ev_text_primary"
        android:textSize="@dimen/sys_value_size"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/metric_caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:textColor="@color/ev_text_secondary"
        android:textSize="@dimen/info_card_body_size" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
