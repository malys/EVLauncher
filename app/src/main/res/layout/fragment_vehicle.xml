<?xml version="1.0" encoding="utf-8"?>
<!-- Carousel page 3: read-only vehicle telemetry, refreshed only while the page is visible.
     Three cards on a panel sized for four — the headroom is deliberate, so battery power,
     temperature or odometer can join without a redesign. See docs/CR-010-vehicle-page.md.
     Nothing here is touchable: the page reads the car and never writes it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:baselineAligned="false"
    android:padding="@dimen/screen_padding">

    <!-- State of charge -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginEnd="@dimen/card_gap"
        android:background="@drawable/smallcard_selector"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/info_card_padding">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/veh_charge"
            android:textColor="@color/ev_text_primary"
            android:textSize="@dimen/small_card_label_size"
            android:textStyle="bold" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tv_soc_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/veh_unknown"
            android:textColor="@color/ev_text_primary"
            android:textSize="@dimen/sys_value_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_soc_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/ev_text_secondary"
            android:textSize="@dimen/info_card_body_size" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- Remaining range -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginEnd="@dimen/card_gap"
        android:background="@drawable/smallcard_selector"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/info_card_padding">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/veh_range"
            android:textColor="@color/ev_text_primary"
            android:textSize="@dimen/small_card_label_size"
            android:textStyle="bold" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tv_range_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/veh_unknown"
            android:textColor="@color/ev_text_primary"
            android:textSize="@dimen/sys_value_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_range_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/ev_text_secondary"
            android:textSize="@dimen/info_card_body_size" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- Charging state -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/smallcard_selector"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/info_card_padding">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/veh_charging"
            android:textColor="@color/ev_text_primary"
            android:textSize="@dimen/small_card_label_size"
            android:textStyle="bold" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Smaller than the two numbers beside it: "Plugged in, not charging" is a sentence,
             and at 32sp it would wrap to three lines on a third of the panel. -->
        <TextView
            android:id="@+id/tv_charging_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/veh_unknown"
            android:textColor="@color/ev_text_primary"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_charging_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/ev_text_secondary"
            android:textSize="@dimen/info_card_body_size" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>
</LinearLayout>
