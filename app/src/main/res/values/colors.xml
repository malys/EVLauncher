<?xml version="1.0" encoding="utf-8"?>
<!-- MG4 suite palette — the same tokens as MG4Control and MG4Tasker. The SAIC light
     palette this app shipped with is gone: the suite is dark-only, on purpose. -->
<resources>
    <!-- Contraste : l'écran est lu en plein jour, souvent avec un reflet. Les couleurs
         restent au-dessus de 7:1 (AAA) sur leur fond, pas seulement au-dessus du minimum
         AA de 4,5:1, qui décroche dès que la luminosité extérieure monte. -->
    <color name="mg4_background">#FF0B0D0F</color>
    <color name="mg4_surface">#FF15181C</color>
    <color name="mg4_surface_raised">#FF272C33</color>
    <!-- Bordure des cartes : sans elle, surface et surface_raised se confondent au soleil. -->
    <color name="mg4_outline">#FF4A525B</color>
    <color name="mg4_accent">#FF7FD4FA</color>
    <color name="mg4_on_accent">#FF04121A</color>
    <color name="mg4_text_primary">#FFF4F7FA</color>
    <!-- 9,3:1 sur mg4_surface — l'ancien #9EA6AE tombait à 6:1, illisible au soleil. -->
    <color name="mg4_text_secondary">#FFC6CFD8</color>
    <color name="mg4_error">#FFFF9A9A</color>

    <!-- Pressed-state overlays on the surfaces above. Alpha, not a separate hue, so a
         pressed card still reads as the same card. -->
    <color name="mg4_pressed">#1FFFFFFF</color>
    <color name="mg4_pressed_strong">#33FFFFFF</color>
</resources>
