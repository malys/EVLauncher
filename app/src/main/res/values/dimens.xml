<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MG4 suite tokens (same values as MG4Tasker). Vehicle screen: ~10 inches, ~70 cm
         from the driver, used while driving. Everything is larger than on a hand-held phone. -->
    <dimen name="touch_target">72dp</dimen>
    <dimen name="spacing_xs">4dp</dimen>
    <dimen name="spacing_sm">8dp</dimen>
    <dimen name="spacing_md">16dp</dimen>
    <dimen name="spacing_lg">24dp</dimen>

    <dimen name="text_title">26sp</dimen>
    <dimen name="text_body">20sp</dimen>
    <dimen name="text_secondary">17sp</dimen>
    <dimen name="text_label">16sp</dimen>

    <!-- Corner radius shared by every MG4 surface. -->
    <dimen name="mg4_corner">12dp</dimen>

    <!-- Launcher-specific: the home screen is glanceable at speed, so the favourite tiles
         and their labels are deliberately larger than the suite body sizes. -->
    <dimen name="screen_padding">24dp</dimen>
    <dimen name="card_gap">16dp</dimen>
    <dimen name="favorite_icon_size">160dp</dimen>
    <dimen name="favorite_label_size">30sp</dimen>
    <!-- Grille à plusieurs rangées : la tuile est deux fois moins haute, le libellé
         doit laisser la place à l'icône qu'il décrit. -->
    <dimen name="favorite_label_size_small">20sp</dimen>
    <dimen name="small_card_label_size">28sp</dimen>
    <dimen name="drawer_title_size">30sp</dimen>
    <dimen name="drawer_icon_size">88dp</dimen>
    <dimen name="drawer_label_size">18sp</dimen>
    <dimen name="fixed_app_padding">24dp</dimen>
    <dimen name="info_card_padding">24dp</dimen>
    <dimen name="info_card_body_size">22sp</dimen>
    <dimen name="sys_value_size">32sp</dimen>
    <dimen name="page_indicator_active_width">32dp</dimen>
    <dimen name="page_indicator_inactive_width">16dp</dimen>
    <dimen name="page_indicator_height">6dp</dimen>
    <dimen name="page_indicator_margin_bottom">12dp</dimen>
</resources>
