<?xml version="1.0" encoding="utf-8"?>
<!-- Dimensions specific to MG4 Simple Launcher. Shared tokens are in dimens.xml
     (generated by tools/sync-tokens.mjs - do not add a local value there).

     The home screen is read while driving, so the favourite tiles and their labels are
     deliberately larger than the suite body sizes. -->
<resources>
    <dimen name="screen_padding">@dimen/spacing_lg</dimen>
    <dimen name="card_gap">@dimen/spacing_md</dimen>
    <dimen name="fixed_app_padding">@dimen/spacing_lg</dimen>
    <dimen name="info_card_padding">@dimen/spacing_lg</dimen>

    <dimen name="favorite_icon_size">160dp</dimen>
    <dimen name="favorite_label_size">30sp</dimen>
    <!-- Multi-row grid: the tile is half as tall, so the label has to leave room for
         the icon it describes. -->
    <dimen name="favorite_label_size_small">20sp</dimen>
    <dimen name="small_card_label_size">28sp</dimen>

    <dimen name="drawer_title_size">@dimen/text_display</dimen>
    <dimen name="drawer_icon_size">88dp</dimen>
    <dimen name="drawer_label_size">18sp</dimen>

    <dimen name="info_card_body_size">22sp</dimen>
    <dimen name="sys_value_size">@dimen/text_display</dimen>

    <dimen name="page_indicator_active_width">32dp</dimen>
    <dimen name="page_indicator_inactive_width">16dp</dimen>
    <dimen name="page_indicator_height">6dp</dimen>
    <dimen name="page_indicator_margin_bottom">12dp</dimen>
</resources>
