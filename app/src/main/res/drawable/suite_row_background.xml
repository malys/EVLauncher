<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/mg4_surface_raised" />
            <stroke android:width="1dp" android:color="@color/mg4_outline" />
            <corners android:radius="@dimen/mg4_corner" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/mg4_surface" />
            <stroke android:width="1dp" android:color="@color/mg4_outline" />
            <corners android:radius="@dimen/mg4_corner" />
        </shape>
    </item>
</selector>
