<?xml version="1.0" encoding="utf-8"?>
<!-- Transparent at rest, ripple only while pressed: gives the two fixed icons touch
     feedback without drawing a permanent tile inside the card. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ev_pressed_strong">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/ev_corner" />
            <solid android:color="@android:color/white" />
        </shape>
    </item>
</ripple>
