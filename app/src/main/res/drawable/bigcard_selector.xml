<?xml version="1.0" encoding="utf-8"?>
<!-- Favourite card on the home screen. Raised MG4 surface, suite corner radius, Material ripple instead of the old pressed-state PNG. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/mg4_pressed_strong">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/mg4_corner" />
            <solid android:color="@android:color/white" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/mg4_corner" />
            <solid android:color="@color/mg4_surface_raised" />
        </shape>
    </item>
</ripple>
