<?xml version="1.0" encoding="utf-8"?>
<!-- Tonal button surface shared by the drawer header controls. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ev_pressed_strong">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/ev_corner" />
            <solid android:color="@android:color/white" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/ev_corner" />
            <solid android:color="@color/ev_surface_raised" />
        </shape>
    </item>
</ripple>
