<?xml version="1.0" encoding="utf-8"?>
<!-- A tile picked up to be moved: raised surface and a thick accent contour — two signals,
     because one is a colour. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="@dimen/ev_corner" />
    <solid android:color="@color/ev_surface_raised" />
    <stroke android:width="4dp" android:color="@color/ev_accent" />
</shape>
